# Frontend — variáveis de ambiente
# Copie para .env antes de rodar fora do Docker

# URL base da API (Kong)
VITE_API_URL=http://localhost:8000

# URL do WebSocket (Kong)
VITE_WS_URL=http://localhost:8000

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_REALM=crash-game
VITE_CLIENT_ID=crash-game-client
