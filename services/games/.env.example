# Game Service — variáveis de ambiente
# Copie para .env antes de rodar fora do Docker

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/games
DATABASE_SSL=false

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Keycloak (JWKS para validação de JWT)
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/crash-game/protocol/openid-connect/certs

# Servidor
PORT=4001
NODE_ENV=development

# Jogo
BETTING_DURATION_MS=10000
